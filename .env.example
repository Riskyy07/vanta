# VANTA V1.9 — Real Blockchain Intelligence / Base Mainnet (chain 8453)
# PostgreSQL is optional for source-live mode and required for persistent history/lifecycle intelligence.
DATABASE_URL=
DATABASE_SSL=false
VANTA_DB_POOL_MAX=10
VANTA_DB_IDLE_TIMEOUT_MS=30000
VANTA_DB_CONNECT_TIMEOUT_MS=10000

# Blockscout real-data source
BLOCKSCOUT_MODE=instance
BLOCKSCOUT_API_BASE_URL=https://base.blockscout.com/api/v2
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_CHAIN_ID=8453
VANTA_CHAIN_SLUG=base
VANTA_CHAIN_NAME=Base Mainnet

# Source-live intelligence (works without PostgreSQL)
VANTA_SOURCE_LIVE_PAGES=4
VANTA_SOURCE_LIVE_WALLETS=36
VANTA_SOURCE_LIVE_CACHE_MS=30000

# Optional seed wallets. Auto discovery can bootstrap the persistent pipeline when empty.
VANTA_WALLETS=
VANTA_DISCOVERY_ENABLED=true
VANTA_DISCOVERY_PAGES=3
VANTA_DISCOVERY_CANDIDATE_LIMIT=40
VANTA_DISCOVERY_PROMOTE_LIMIT=8
VANTA_DISCOVERY_INTERVAL_MS=600000
VANTA_TRACKED_WALLET_LIMIT=80
VANTA_DISCOVERY_MIN_TRANSFERS=2
VANTA_DISCOVERY_MIN_TOKENS=1
VANTA_MAX_WALLETS_PER_CYCLE=20

# USD enrichment: Blockscout first, DEX Screener fallback for missing prices
VANTA_PRICE_ENRICHMENT=true
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
VANTA_PRICE_CACHE_MS=300000
VANTA_PRICE_MIN_LIQUIDITY_USD=5000
VANTA_MIN_USD_COVERAGE_PCT=70

# Persistent worker controls
VANTA_WORKER_INTERVAL_MS=300000
VANTA_WORKER_ONCE=false
VANTA_MAX_PAGES_PER_WALLET=50

# Set true only if the web runtime must fail closed unless PostgreSQL is configured.
# Keep false to allow real source-live intelligence before/without the persistent DB.
VANTA_REQUIRE_LIVE_DATA=false
VANTA_MONITORING_SECRET=
VANTA_REQUIRE_MONITORING=false

# Historical retention for persistent mode
VANTA_SIGNAL_HISTORY_RETENTION_DAYS=180
VANTA_BEHAVIOR_HISTORY_RETENTION_DAYS=180
VANTA_ALERT_RETENTION_DAYS=90
VANTA_INGESTION_RUN_RETENTION_DAYS=30
VANTA_CANDIDATE_RETENTION_DAYS=14
VANTA_PRICE_RETENTION_DAYS=7
VANTA_RETENTION_INTERVAL_MS=3600000

# Recommended deployment: Netlify web + managed PostgreSQL + GitHub Actions worker
# See DEPLOYMENT_NETLIFY_NEON.md and REAL_PRODUCT_STATUS.md
